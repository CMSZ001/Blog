---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import config from "@/config";
import { useTranslations } from "@/i18n";
import IconCreativeCommons from "@/assets/icons/IconCreativeCommons.svg";
import LinkButton from "./LinkButton.astro";

dayjs.extend(utc);
dayjs.extend(timezone);

interface Props {
  title: string;
  url: string;
  pubDatetime: string | Date;
  timezone?: string;
  author: string;
}

const { title, url, pubDatetime, timezone: postTimezone, author } = Astro.props;
const t = useTranslations(Astro.currentLocale);

const date = dayjs(pubDatetime)
  .tz(postTimezone ?? config.site.timezone)
  .format("YYYY/MM/DD");

const { url: licenseUrl, name: licenseName } = config.license;
---

<div
  class="bg-muted/50 relative overflow-hidden rounded-lg px-6 py-5 transition"
>
  <div class="text-foreground/85 text-sm font-semibold">{title}</div>
  <LinkButton
    href={url}
    class="text-foreground text-sm break-all underline decoration-dashed underline-offset-4"
    >{url}</LinkButton
  >
  <div class="mt-2 flex flex-wrap gap-x-6 gap-y-1">
    <div>
      <div class="text-foreground/80 text-xs">{t.post.author}</div>
      <div class="text-foreground/85 text-sm">{author}</div>
    </div>
    <div>
      <div class="text-foreground/80 text-xs">{t.post.publishedAt}</div>
      <div class="text-foreground/85 text-sm">{date}</div>
    </div>
    <div>
      <div class="text-foreground/80 text-xs">{t.post.license}</div>
      <div
        class="text-foreground text-sm underline decoration-dashed underline-offset-4"
      >
        <LinkButton href={licenseUrl} target="_blank" rel="noopener noreferrer">
          {licenseName}
        </LinkButton>
      </div>
    </div>
  </div>

  <IconCreativeCommons
    class="text-accent/10 dark:text-accent/5 pointer-events-none absolute top-1/2 right-4 size-48 -translate-y-1/2"
    aria-hidden="true"
  />
</div>
